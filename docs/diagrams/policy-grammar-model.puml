@startuml
' Purpose: Policy expression grammar and precedence model
' Source of truth:
'   src/api/policyParser/tokens.ts
'   src/api/policyParser/parser.ts

title Policy Expression Language - Grammar Diagram

class "Expression (parseExpr)" as Expression
class "LogicalAnd (parseAnd)" as LogicalAnd
class "Comparison (parseComparison)" as Comparison
class "Term (parseTerm)" as Term
class "Factor (parseFactor)" as Factor
class "Unary (parseUnary)" as Unary
class "Primary (parsePrimary)" as Primary

Expression --> LogicalAnd
LogicalAnd --> Comparison
Comparison --> Term
Term --> Factor
Factor --> Unary
Unary --> Primary
Primary ..> Term : "( term )"

note right of Expression
  Logical OR (lowest precedence):
  ||
end note

note right of LogicalAnd
  Logical AND:
  &&
end note

note right of Comparison
  Comparison operators (single, not chained):
  == != < <= > >=
  Operands must be numbers.
end note

note right of Term
  Additive:
  + -
end note

note right of Factor
  Multiplicative:
  * /   (division by zero -> error)
end note

note right of Unary
  Unary minus:
  -x
end note

note bottom of Primary
  Primary tokens:
  - Number literals
  - Identifiers (e.g. PNRS_2, OSS.total, OSS_week4)
    unknown identifier -> error (rule does not fire)
  - Parenthesized arithmetic only (parseTerm);
    comparisons/logic inside ( ) are rejected

  Implemented in:
  src/api/policyParser/tokens.ts
  src/api/policyParser/parser.ts
end note

@enduml
