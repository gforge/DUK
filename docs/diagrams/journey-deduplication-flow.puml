@startuml
' Purpose: Parallel journey due-step deduplication
' Source of truth:
'   src/api/service/journeyResolver.ts
'   src/api/service/journeyConflicts.ts
'   src/api/service/patientJourneys.ts

title Parallel Journeys - Due-Step Deduplication Activity Diagram

start
partition "At assignment (AssignJourneyDialog)" {
  :detectJourneyConflicts(patientId, templateId, startDate);
  :Resolve new template steps
  (getEffectiveStepsForTemplate);
  :Match against steps of existing
  ACTIVE/SUSPENDED journeys
  (same templateId, overlapping windows);
  if (clinician merges conflicting steps?) then (yes)
    :assignPatientJourney(..., mergedStepIds);
    :Store REMOVE_STEP modifications
    with mergedFromJourneyId;
  else (no)
    :assignPatientJourney without merges;
  endif
}

partition "At runtime (PatientDueForms)" {
  :Load ACTIVE/SUSPENDED journeys for patient;
  :For each journey -> getEffectiveSteps(journeyId);
  :Keep steps with templateId whose window
  (scheduledDate ± windowDays) contains date;
  :Skip steps already submitted
  (patientJourneyId + base entry id
  + occurrenceIndex);
  if (templateId already collected?) then (yes)
    :Keep first step;
    :Append journey id to journeyIds;
  else (no)
    :Add step with journeyIds = [journeyId];
  endif
  :Return MergedDueStep[]
  sorted by scheduledDate, order;
  :Render questionnaire list once per templateId;
}
stop

note right
  Runtime merge implemented by:
  getMergedDueStepsForPatient(patientId, date)
  in src/api/service/journeyResolver.ts
end note

@enduml
