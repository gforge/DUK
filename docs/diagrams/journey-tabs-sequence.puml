@startuml
' Purpose: Multi-journey tab rendering in clinician and patient views
' Source of truth:
'   src/components/case/JourneyTab/index.tsx
'   src/components/case/JourneyTab/JourneySelectorTabs.tsx
'   src/components/patientView/PatientCareplan/main.tsx
'   src/pages/PatientView.tsx
'   src/api/client/patientJourneys.ts

title Multiple Journeys - Tab Rendering Sequence Diagram

actor Clinician
participant "JourneyTab\n(CaseDetail UI)" as JT
participant "PatientView\n(page)" as PV
participant "PatientCareplan\n(PatientView UI)" as PC
participant "client/patientJourneys" as Client
participant "service/journeyResolver" as Resolver

== Clinician view (CaseDetail) ==
Clinician -> JT : Open journey tab
JT -> Client : getPatientJourneys(patientId)
Client --> JT : PatientJourney[]
JT -> JT : Sort by\nACTIVE -> SUSPENDED -> COMPLETED\nnewest first within group
JT -> JT : EpisodeHeader + ReferralCard\n(episode of selected journey)
JT -> JT : JourneySelectorTabs\n(only when > 1 journey)
Clinician -> JT : Select a journey tab
JT -> Client : getEffectiveSteps(journeyId)
Client -> Resolver : getEffectiveSteps(journeyId)
Resolver --> Client : EffectiveStep[]
Client --> JT : EffectiveStep[]
JT -> Client : getResolvedInstructionsForJourney(journeyId)
Client --> JT : ResolvedInstruction[]
JT -> JT : Render JourneyHeader (actions),\nresearch card, InstructionTimeline,\nJourneyTimeline, JourneyModHistory

== Patient self-view (PatientCareplan) ==
Clinician -> PV : Switch role to PATIENT
PV -> Client : getPatientJourneys(patientId)
Client --> PV : PatientJourney[]
PV -> PC : journeys, journeyTemplates
PC -> PC : Same ordering, tabs only when > 1\nread-only InstructionTimeline +\nJourneyTimeline per journey
PC -> Client : getEffectiveSteps(selectedJourneyId)
Client --> PC : EffectiveStep[]

@enduml
