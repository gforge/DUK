@startuml
' Purpose: Runtime <-> template bindings
' Source of truth:
'   src/api/service/patientJourneys.ts
'   src/api/service/instructions.ts
'   src/api/service/journeyResolver.ts
'   src/api/schemas/forms.ts

title Runtime-Template Bindings Flow

left to right direction
skinparam linetype ortho
skinparam shadowing false

rectangle "Template Layer" #FFF8E1 {
  class JourneyTemplate
  class JourneyTemplateEntry
  class JourneyTemplateInstruction
  class InstructionTemplate
}

rectangle "Runtime Layer" #E8F5E9 {
  class PatientJourney
  class Instruction
  class FormResponse
}

JourneyTemplate --> PatientJourney : assignPatientJourney() /\nstartNextPhase()
JourneyTemplateInstruction --> Instruction : instantiate on assignment /\nnext phase (journeyTemplateInstructionId)
InstructionTemplate --> Instruction : instructionTemplateId\n(also ad hoc via addJourneyInstruction)
JourneyTemplateEntry --> FormResponse : journeyTemplateEntryId\n(base id, + occurrenceIndex)
PatientJourney --> FormResponse : patientJourneyId
PatientJourney --> JourneyTemplate : journeyTemplateId

note bottom
  getEffectiveSteps() resolves steps from JourneyTemplateEntry at read time
  (pause shift, recurrence, modifications, research overlays),
  while Instruction rows are persisted runtime entities with resolved
  startAt/endAt (re-dated on resumeJourney).
end note

@enduml
