@startuml
' Purpose: Journal draft generation and persistence flow
' Source of truth:
'   src/api/service/journal.ts
'   src/api/journalRenderer.ts
'   src/components/case/JournalTab/index.tsx
'   src/components/case/JournalDraftCard.tsx

title Journal Draft Generation - Sequence Diagram

actor Clinician
participant "JournalTab\n(UI)" as UI
participant "client/journal" as Client
participant "service/journal" as Service
participant "journeyResolver" as Resolver
participant "JournalRenderer" as JR

Clinician -> UI : select journal template\n(templates for current UI language)
UI -> Client : generateJournalDraft(caseId, templateId,\nuserId, role, language)
Client -> Service : generateJournalDraft(...)
Service -> Service : fetch case, patient, template,\ncase responses (newest first)
Service -> Resolver : getEffectiveSteps(newest ACTIVE journey)
Resolver --> Service : steps with scoreAliases / scoreAliasLabels
Service -> Service : build aliasedScores\n(latest response per step template)
Service -> JR : renderTemplate(body, {patient, caseData,\nresponses, aliasedScores, language})
JR --> Service : rendered Markdown
Service -> Service : save JournalDraft (DRAFT)\n+ audit JOURNAL_DRAFT_CREATED
Service --> Client : JournalDraft
Client --> UI : refetch drafts
UI -> UI : JournalDraftCard renders\nMarkdown (copy / print)

alt deselect template
  Clinician -> UI : deselect template
  UI -> Client : deleteJournalDraft(draftId, userId, role)
  Client -> Service : delete draft\n+ audit JOURNAL_DRAFT_DELETED
else approve (DOCTOR)
  Clinician -> UI : approve draft
  UI -> Client : approveJournalDraft(draftId, userId, role)
  Client -> Service : status = APPROVED\n+ audit JOURNAL_DRAFT_APPROVED
end

note right of JR: src/api/journalRenderer.ts

@enduml
