@startuml
' Purpose: Combined rendering and deduplication for parallel journeys
' Source of truth:
'   src/api/service/journeyResolver.ts
'   src/components/case/JourneyTab/index.tsx
'   src/components/patientView/PatientCareplan/main.tsx
'   src/components/patientView/PatientDueForms/index.tsx

title Multiple Journeys - Combined Rendering And Deduplication

actor Clinician
actor Patient
participant "JourneyTab\n(CaseDetail UI)" as JT
participant "PatientCareplan /\nPatientDueForms\n(PatientView UI)" as PC
participant "client/\npatientJourneys" as Client
participant "getEffectiveSteps" as GES
participant "getMergedDueSteps\nForPatient" as MDS

== Clinician view (CaseDetail / JourneyTab) ==

Clinician -> JT : Open case detail\n(journey tab)
JT -> Client : getPatientJourneys(patientId)
Client --> JT : PatientJourney[]\n(e.g. wrist + hip programmes)
JT -> JT : Sort journeys:\n  ACTIVE → SUSPENDED → COMPLETED\n  newest-first within group
JT -> JT : Render JourneySelectorTabs\n  (template name + status chip)
Clinician -> JT : Click tab for journey N
JT -> Client : getEffectiveSteps(journeyId_N)
Client -> GES : getEffectiveSteps(journeyId_N)
GES -> GES : Apply pause shift\nExpand recurring entries\nApply modifications\nOverlay research module entries
GES --> Client : EffectiveStep[]
Client --> JT : EffectiveStep[]
JT -> JT : Render JourneyHeader (resume /\nmodify / pause / cancel / next phase)\n+ PatientJourneyResearchCard\n+ InstructionTimeline + JourneyTimeline

== Patient self-view (PatientCareplan) ==

Clinician -> PC : Switch to patient role\n-> /patient
PC -> Client : getPatientJourneys(patientId)\n(via PatientView page)
Client --> PC : PatientJourney[]
PC -> PC : Same sort; read-only timelines\n(no pause/modify controls)

== Patient due forms — deduplication ==

Patient -> PC : Open patient view
PC -> Client : getMergedDueStepsForPatient(\n  patientId, today\n)
Client -> MDS : getMergedDueStepsForPatient(...)

loop per ACTIVE/SUSPENDED journey
  MDS -> GES : getEffectiveSteps(journey_i)
  GES --> MDS : EffectiveStep[]
  MDS -> MDS : Keep steps with templateId\nwhose window contains today\nand not yet submitted
end

MDS -> MDS : Merge by templateId\n(keep first step,\ncollect journeyIds)
MDS --> Client : MergedDueStep[]
Client --> PC : Due forms\n(no duplicate questionnaires)
Patient -> PC : Fill form
PC -> PC : submitFormResponse with\npatientJourneyId = journeyIds[0]

note right of MDS
  Key invariant:
  The same questionnaire
  (templateId) is shown
  at most once per day, even
  when two parallel journeys
  both schedule it.
end note

@enduml
